{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>home-operations/renovate-config"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  packageRules: [
    {
      // A bump has to be reviewed for the CSI v1.13 VolumeHealth sanity
      // specs (present since v5.6.0): they Skip() when the driver lacks the
      // capability, so losing them is silent.
      matchDepNames: ["github.com/kubernetes-csi/csi-test/v5"],
      automerge: false,
    },
  ],
}
