{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>home-operations/renovate-config"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  packageRules: [
    {
      // Pinned to an unreleased master commit for the CSI v1.13 VolumeHealth
      // sanity specs; see the note in go.mod. A bump has to be reviewed for
      // their presence, because losing them is silent.
      matchDepNames: ["github.com/kubernetes-csi/csi-test/v5"],
      automerge: false,
    },
  ],
}
